# Firebase — facultatif : la config du projet eminence-3d407 est intégrée dans src/services/firebase.js
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Moteur LLM : "mock" (local, sans clé) ou "proxy" (backend qui détient la clé Claude/OpenAI)
VITE_LLM_PROVIDER=mock
# URL du proxy (Cloud Function, Cloudflare Worker...). Jamais de clé API côté client.
VITE_LLM_PROXY_URL=
