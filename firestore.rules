rules_version = '2';

// Toutes les écritures passent par les Cloud Functions (SDK Admin, qui ignore ces règles).
// Le navigateur ne peut que lire : ni la progression ni les notes ne sont falsifiables.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /simulations/{simulationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Cours générés une fois par module et partagés entre apprenants.
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
